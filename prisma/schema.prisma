datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model SiteSettings {
  id               Int      @id @default(1) @map("id")
  name             String
  title            String
  tagline          String?
  email            String?
  location         String?
  whatsappPhone    String   @map("whatsapp_phone")
  whatsappMessage  String?  @map("whatsapp_message")
  linkedin         String?
  behance          String?
  instagram        String?
  skills           Json?
  updatedAt        DateTime @map("updated_at") @default(now())

  @@map("site_settings")
}

model Project {
  slug      String @id
  title     String
  image     String
  alt       String?
  role      String?
  year      String?
  tags      Json?
  summary   String?
  problem   String?
  solution  String?
  outcome   String?
  sortOrder Int    @map("sort_order")

  @@map("projects")
}
